# Application
APP_NAME=AI Drama Studio
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATA_ROOT=/app/data
PROVIDER_CONFIG_ROOT=/app/config/providers
MAX_GENERATION_RETRIES=3
PROVIDER_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=262144000

# LLM providers (reserved for ScriptAgent / StoryboardAgent)
# Story generation: a server-side Chat Completions endpoint returning JSON.
PLANNING_API_URL=
PLANNING_API_KEY=
PLANNING_MODEL=
# Optional explicit .env source of OPENAI_API_KEY. Only used with the official
# https://api.openai.com/v1/chat/completions endpoint; PLANNING_API_KEY wins.
PLANNING_OPENAI_ENV_FILE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# Dedicated video subscription key; never falls back to MINIMAX_API_KEY.
MINIMAX_TOKEN_PLAN_KEY=
# Optional explicit reuse of legacy Content Generator's .env MINIMAX_API_KEY.
MINIMAX_TOKEN_PLAN_ENV_FILE=
MINIMAX_VIDEO_BASE_URL=https://api.minimaxi.com/v1

# Seedance 2.0 through Volcengine Ark (API Key, not Access Key / Secret Key)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128

# Kling current API Key protocol; do not put legacy AK/SK here.
# Also used for character portraits (Kling Image 3.0 / model_name=kling-v3).
# Master-reference mode uses Kling Image 3.0 Omni (model_name=kling-v3-omni).
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-3.0
KLING_API_VERSION=

# Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=ai-drama-studio

# Database (SQLite alternative: sqlite:////app/data/ai_drama_studio.db)
DATABASE_URL=postgresql+psycopg://ai_drama:change-me@db:5432/ai_drama

# Redis (reserved for the Phase 5 worker/orchestration layer)
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
