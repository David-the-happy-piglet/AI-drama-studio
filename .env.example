# Database
DB_NAME=content_generator
DB_USER=content_generator
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://content_generator:change-me@db:5432/content_generator

# Redis / object storage reserved for async jobs and generated assets
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-now

# Browser-accessible URL used for locally generated placeholder images
PUBLIC_BASE_URL=http://localhost:8000

# Text generation
# mock: local deterministic demo
# compatible: an OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90

# Three providers used by the comparison flow.
# Fill only the values after "=". Never commit your real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# Kimi's official environment variable name is MOONSHOT_API_KEY.
MOONSHOT_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# Image generation
# placeholder: local demo images
# compatible: an OpenAI-compatible /images/generations endpoint
# minimax: MiniMax image_generation endpoint (reuses MINIMAX_API_KEY)
IMAGE_PROVIDER=placeholder
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_SECONDS=120
MINIMAX_IMAGE_MODEL=image-01
# Keep AI image identification enabled for automated publishing.
AIGC_WATERMARK=true

# WeChat Official Account
# Keep disabled until AppID, AppSecret and interface permissions are verified.
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
WECHAT_API_BASE=https://api.weixin.qq.com

# Articles with safety flags are blocked from draft upload by default.
ALLOW_FLAGGED_PUBLISH=false

# Daily automation worker
# The plan's actual time and timezone are configured in the admin console.
AUTOMATION_POLL_SECONDS=30
AUTOMATION_MAX_RETRIES=3
AUTOMATION_STALE_MINUTES=120
